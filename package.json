{
  "name": "rlracing-presentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Slide deck explaining the RL Racing league: reveal.js slides, Remotion infographics, three.js car + observation scene",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "export:assets": "JAX_PLATFORMS=cpu RLR_NO_JAX_CACHE=1 /Users/devichen/workplace/hackathon/src/CXBTRLRacingHackathon/.venv/bin/python scripts/export_assets.py",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:ensure": "remotion browser ensure",
    "render:videos": "bash scripts/render_videos.sh",
    "export:pdf": "node scripts/export_pdf.mjs",
    "check": "npm run export:assets && npm run render:videos && npm run build"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.534",
    "reveal.js": "^6.0.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  }
}
